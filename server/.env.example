# --- Server ---
PORT=3000
# Where the React client runs (used for CORS, sockets, and invitation links)
CLIENT_URL=http://localhost:5173
# Set to 1 when running behind a reverse proxy
# TRUST_PROXY=1

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/teamflow

# --- Auth ---
# At least 32 random characters
JWT_SECRET=change-me-to-a-long-random-string-32chars-min
# e.g. 1h, 7d
JWT_EXPIRES_IN=7d

# --- Email (invitation emails) ---
# Gmail: use an App Password. For other providers also set SMTP_HOST.
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="TeamFlow <you@gmail.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
